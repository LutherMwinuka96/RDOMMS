# RDOMMS environment configuration
# Copy to .env and adjust for your server.

APP_ENV=local
APP_URL=http://localhost/RDOMMS

# Database
DB_HOST=localhost
DB_NAME=rdomms_db
DB_USER=root
DB_PASSWORD=
# Optional fallback password (used only if DB_PASSWORD fails)
DB_PASSWORD_FALLBACK=

# Field-level encryption at rest (AES-256-GCM). Generate a long random secret for production.
# Example: openssl rand -base64 48
DB_ENCRYPTION_KEY=

# HTTPS / cookies
# Local: keep FORCE_HTTPS=0 and SESSION_SECURE=0
# Production: set APP_ENV=production (auto-enables HTTPS redirect + secure cookies when on SSL)
FORCE_HTTPS=0
FORCE_HTTPS_AUTO=1
SESSION_SECURE=
SESSION_SAMESITE=Lax

# Security
CSRF_ENABLED=1
CORS_ALLOWED_ORIGIN=

# Web Application Firewall / IDS
WAF_ENABLED=1
WAF_BLOCK_SCORE=85
WAF_IDS_BLOCK_SCORE=120
WAF_IDS_MAX_VIOLATIONS=5
WAF_IDS_WINDOW_MINUTES=15
WAF_IDS_BLOCK_MINUTES=60

# Rate limiting (login / password reset)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_PASSWORD_MAX=3
RATE_LIMIT_PASSWORD_WINDOW=30

# Session management (idle timeout in minutes, warning before expiry in seconds)
SESSION_IDLE_MINUTES=10
SESSION_WARN_SECONDS=60
SESSION_OFFLINE_AUTH=0
APP_TIMEZONE=Africa/Dar_es_Salaam
